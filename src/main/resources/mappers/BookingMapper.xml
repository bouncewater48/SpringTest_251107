<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bounce.springtest.ajax.repository.BookingRepository">
    <select id="selectBooking"
    resultType="com.bounce.springtest.ajax.domain.Booking">
        SELECT
            `id`
            , `name`
            , `headcount`
            , `day`
            , `date`
            , `phone_number`
            , `state`
            , `created_at`
            , `updated_at`
        FROM
            `booking`
        ORDER BY
            `date`
    </select>
</mapper>