<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bounce.springtest.mvc.repository.SellerRepository">

    <insert id="insertSeller" parameterType="map">
        INSERT INTO
            `seller`
        (
            `nickname`
            , `temperature`
            , `profile_image`
        )
        VALUE
        (
            #{nickname}
            , #{temperature}
            , #{profileImage}
        )
    </insert>

    <select id="selectLastSeller"
    resultType="com.bounce.springtest.mvc.domain.Seller">

        SELECT
            `id`
            , `nickname`
            , `temperature`
            , `profile_image`
            , `createrd_at`
            , `updated_at`
        FROM
            `seller`
        ORDER BY `id` DESC
        LIMIT 1
    </select>

    <select id="selectSeller" parameterType="int"
                resultType="com.bounce.springtest.mvc.domain.Seller">

        SELECT
            `id`
             , `nickname`
             , `temperature`
             , `profile_image`
             , `createrd_at`
             , `updated_at`
        FROM
            `seller`
        WHERE
            `id` = #{id}

    </select>

</mapper>