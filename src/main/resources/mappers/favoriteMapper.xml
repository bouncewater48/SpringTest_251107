<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bounce.springtest.ajax.repository.FavoriteRepository">
    <select id="selectFavoriteList"
    resultType="com.bounce.springtest.ajax.domain.Favorite">
        SELECT
            `id`
            , `name`
            , `url`
            , `creatdAt`
            , `updatedAt`
        FROM
            `favoritelist`
    </select>
</mapper>